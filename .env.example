# Copy this file to .env and fill in the real values locally.
NODE_ENV=development
PORT=5005
DATABASE_URL=mongodb://localhost:27017/property_erp
JWT_SECRET=replace-with-a-strong-secret
JWT_REFRESH_EXPIRES_IN=30d
STRIPE_SECRET_KEY=replace-with-your-stripe-test-secret
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
